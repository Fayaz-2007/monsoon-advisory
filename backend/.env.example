# Copy to backend/.env and edit. Every value here has a sane default in pipeline/config.py.

# --- Database ---
# Native PostgreSQL 16 + PostGIS on localhost:5432 (see README). The Docker option
# publishes on 5433 instead, with user/password monsoon/monsoon.
DATABASE_URL=postgresql+psycopg2://monsoon_app:CHANGE_ME@localhost:5432/monsoon
# Superuser password for local admin tasks only (psql -U postgres). Not used by the pipeline.
PG_SUPERUSER_PASSWORD=CHANGE_ME

# --- Region of interest (change these to add another state) ---
STATE_NAME=Tamil Nadu
STATE_CODE=tn
# Bounding box used to crop gridded data (degrees; padded around the state)
BBOX_LAT_MIN=7.75
BBOX_LAT_MAX=13.75
BBOX_LON_MIN=76.0
BBOX_LON_MAX=80.5
# Optional: explicit boundary file inside data/raw/boundaries/ (else auto-discovered)
BOUNDARY_FILE=
CROP_CALENDAR_FILE=crop_calendar_tn.csv

# --- Date range defaults (CLI --start/--end override these) ---
START_DATE=1991-01-01
END_DATE=2025-12-31
CLIM_START_YEAR=1991
CLIM_END_YEAR=2020

# --- Feature settings ---
DRY_DAY_THRESHOLD_MM=2.5
MONSOON_SEASON_START_MONTH=6
MONSOON_SEASON_END_MONTH=12

# --- MJO source: rmm_then_romi | rmm_only | romi_only ---
MJO_SOURCE_MODE=rmm_then_romi
# Calibration rotating ROMI onto RMM phase space (fitted on the 1991-2024 overlap)
ROMI_ROTATION_DEG=-30

# --- IMD real-time downloads (daily mode) ---
IMD_REALTIME_WORKERS=4
IMD_REALTIME_DAYS_BACK=10
DAILY_BACKFILL_DAYS=365

# --- Optional ERA5 (Copernicus CDS). Leave blank to skip ERA5 entirely. ---
# Get a key at https://cds.climate.copernicus.eu/profile (Personal Access Token)
CDS_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api
ERA5_START_DATE=2015-01-01

# --- Optional HTTP proxy for downloads, e.g. http://user:pass@host:port ---
HTTP_PROXY_URL=

# --- Backend API (Segments 3, 4, 5, 7) ---
# Demo mode: mocks are labelled in every response that uses them.
DEMO_MODE=true
# Forecasts: mock (deterministic generator) | real (Segment 2 forecasts table). Switchable at
# runtime with POST /api/settings/forecast-source.
FORECAST_SOURCE=mock
MOCK_SEED=42
# Pin "today" for a reproducible demo (blank = real date), e.g. 2026-09-29
# DEMO_TODAY=2026-09-29
# Only "mock" / "simulated" exist today; the switches mark where real services plug in.
FARMER_COUNT_SOURCE=mock
DELIVERY_MODE=simulated
DELIVERY_SIM_SECONDS=8
# Optional Claude API key: simpler advisory wording + LLM chat. Everything works without it.
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_S=20
# Vite dev server origins (any localhost port is also allowed)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Schema for the backend tables (tests use a throwaway one)
APP_DB_SCHEMA=public
